# --- Jira connection ---
# Base URL of your company's Jira (Server/Data Center), no trailing slash.
JIRA_BASE_URL=https://jira.mycompany.com

# Jira REST API version exposed by your instance. Server/Data Center is "2".
JIRA_API_VERSION=2

# How to authenticate to Jira:
#   kerberos - use the local machine's Kerberos ticket cache via `curl --negotiate`.
#              Requires a valid TGT (run `kinit you@YOUR.REALM` first; check with `klist`)
#              and a curl build with GSS-API/SPNEGO support (curl -V | grep -i gss).
#   token    - HTTP Basic auth with an Atlassian API token (fallback / non-Kerberos Jira).
JIRA_AUTH_MODE=kerberos

# Only used when JIRA_AUTH_MODE=token
JIRA_EMAIL=
JIRA_API_TOKEN=

# --- Scope: which issues Flightdeck is allowed to see ---
# Base JQL that every query is scoped to. Keep this tight - it's your team's slice of Jira.
# Example: project in (ENG, INFRA) AND statusCategory != Done
JIRA_BASE_JQL=project in (ENG)

# Max issues fetched per refresh (Jira will not return more than this in one page).
JIRA_MAX_RESULTS=200

# --- Squad mapping ---
# Squad is resolved per-ticket in this order:
#   1. If the issue has a label present in JIRA_SQUAD_LABELS, use the mapped squad name.
#   2. Otherwise, fall back to the issue's Jira project name.
# Format: comma-separated label=Squad pairs.
# Example: team-platform=Platform,team-web=Web,team-mobile=Mobile,team-infra=Infra
JIRA_SQUAD_LABELS=

# --- Status semantics ---
# Regex (case-insensitive) used to flag a status as "Blocked" for KPIs/attention feed,
# independent of your workflow's exact status names.
JIRA_BLOCKED_STATUS_REGEX=block

# --- Creating tickets (used by "New ticket" and the chat "create:" command) ---
JIRA_DEFAULT_PROJECT=ENG
JIRA_DEFAULT_ISSUETYPE=Task

# --- Server ---
PORT=8787
CLIENT_ORIGIN=http://localhost:5173

# --- Chat assistant (local LLM via Ollama, optional) ---
# Runs entirely on this machine - no Docker, no cloud API key. Install Ollama
# (https://ollama.com), then: `ollama pull gemma3` and `ollama serve`.
# Tool calls the assistant makes (create/update/delete tickets) go through the
# exact same Jira auth configured above - the LLM never talks to Jira directly.
# If Ollama isn't running, the chat panel falls back to simple canned replies.
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=gemma3
